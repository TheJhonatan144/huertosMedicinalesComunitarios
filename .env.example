# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el ".env" real al repositorio.

# Base de datos PostgreSQL
DB_NOMBRE=huertos
DB_USUARIO=huertos
DB_CLAVE=cambia-esta-clave-local
DB_PUERTO=5432

# Aplicación
APP_PUERTO=8081
# Solo para el primer arranque institucional (no necesario con PERFIL=demo); retira ADMIN_TECNICO_CLAVE después.
ADMIN_TECNICO_USUARIO=
ADMIN_TECNICO_NOMBRE=
ADMIN_TECNICO_CLAVE=
# "demo" carga datos sintéticos y cuentas conocidas SOLO si la base está vacía. Para otro uso, deja vacío o cambia el perfil.
PERFIL=demo
# Contraseña de las cuentas de demostración (solo perfil demo)
DEMO_CLAVE=Demo-2026!
